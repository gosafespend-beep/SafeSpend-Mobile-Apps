# Native projects are generated by `expo prebuild` (CNG), so they are not
# tracked. `android/` alone is 2.9 GB of Gradle output.
ios/
android/

# ---------------------------------------------------------------------------
# Secrets and signing material. NEVER commit these.
#
# The App Store Connect key and the Android upload keystore live outside this
# repo (see OPS-2). Losing the keystore means going through Google's key-reset
# process to update the listing at all, so it belongs in a secrets vault --
# not in version control, where it would be readable by anyone with clone
# access, forever, even after deletion.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
google-services.json
GoogleService-Info.plist
sentry.properties
**/sentry.properties

# OS
.DS_Store
Thumbs.db
